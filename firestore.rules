rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Ham kiem tra nguoi dung da dang nhap chua
    function isSignedIn() {
      return request.auth != null;
    }

    // The laboratory's only business identifier for a standard. The
    // technical Firestore document id is deliberately not used as a visible
    // replacement for this code. SDHET is a separate business operation and
    // is intentionally outside the reusable four-character sequence.
    function validInternalId(value) {
      return value is string && (value == 'SDHET' || value.matches('^[ABC][A-Z0-9]{3}$'));
    }

    function canRepairStandardRequestSnapshot(appId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let stdId = request.resource.data.get('standardId', resource.data.get('standardId', ''));
      let standardPath = /databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId);
      return hasPermission(appId, 'standard_edit') &&
        changed.hasOnly(['standardId', 'internalId', 'usageLogs', 'lastUpdated']) &&
        request.resource.data.lastUpdated == request.time &&
        stdId is string && stdId.size() > 0 && exists(standardPath) &&
        validInternalId(getAfter(standardPath).data.get('internal_id', '')) &&
        request.resource.data.get('internalId', '') == getAfter(standardPath).data.get('internal_id', '') &&
        (!('usageLogs' in request.resource.data) || request.resource.data.usageLogs is list);
    }

    function canRepairStandardUsageSnapshot(appId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let stdId = request.resource.data.get('standardId', resource.data.get('standardId', ''));
      let standardPath = /databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId);
      return hasPermission(appId, 'standard_edit') &&
        changed.hasOnly(['standardId', 'internalId', 'lastUpdated']) &&
        request.resource.data.lastUpdated == request.time &&
        stdId is string && stdId.size() > 0 && exists(standardPath) &&
        validInternalId(getAfter(standardPath).data.get('internal_id', '')) &&
        request.resource.data.get('standardId', '') == stdId &&
        request.resource.data.get('internalId', '') == getAfter(standardPath).data.get('internal_id', '');
    }

    function canRepairNestedStandardUsageSnapshot(appId, stdId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let standardPath = /databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId);
      return hasPermission(appId, 'standard_edit') &&
        changed.hasOnly(['standardId', 'internalId', 'lastUpdated']) &&
        request.resource.data.lastUpdated == request.time &&
        exists(standardPath) &&
        validInternalId(getAfter(standardPath).data.get('internal_id', '')) &&
        request.resource.data.get('standardId', stdId) == stdId &&
        request.resource.data.get('internalId', '') == getAfter(standardPath).data.get('internal_id', '');
    }

    // 2. Kiem tra tai lieu User Profile co ton tai khong
    function userExists(appId) {
      return isSignedIn() && exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid));
    }

    // 3. Lay tai lieu User Profile cua request hien tai
    function getUserProfile(appId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data;
    }

    // 4. Kiem tra User co phai la Manager khong
    function isManager(appId) {
      return userExists(appId) && getUserProfile(appId).get('role', 'pending') == 'manager';
    }

    // Release notes dùng chung cho toàn bộ ứng dụng. APP_ID production hiện tại
    // là lims-cloud-fixed; chỉ Manager của app này được phép publish/cập nhật.
    function isReleaseManager() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/artifacts/lims-cloud-fixed/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/artifacts/lims-cloud-fixed/users/$(request.auth.uid)).data.get('role', 'pending') == 'manager';
    }

    match /releases/{versionId} {
      // Release notes are intentionally public; the /changelog route is
      // reachable before sign-in. Only Managers may publish or update them.
      allow read: if true;
      allow create, update: if isReleaseManager();
    }

    // 5. Tro giup phan giai quyen han khi tai lieu nguoi dung duoc xac dinh la ton tai
    function evaluateUserPermission(appId, profile, permission) {
      let role = profile.get('role', 'pending');
      let rawRoleId = profile.get('roleId', 'role_staff_default');
      let roleId = (rawRoleId == null || rawRoleId == '') ? 'role_staff_default' : rawRoleId;
      let directPerms = profile.get('permissions', []);
      let overridePerms = profile.get('customPermissions', []);
      let hasCustom =
        (directPerms is list && directPerms.hasAny([permission])) ||
        (overridePerms is list && overridePerms.hasAny([permission]));
      
      return role == 'manager' || 
        (
          role == 'viewer' && 
          ['inventory_view', 'standard_view', 'sop_view', 'recipe_view'].hasAny([permission])
        ) ||
        hasCustom ||
        (
          role == 'staff' &&
          (
            // 1. Uu tien cao nhat: Neu manager da cau hinh roles_config thi lay theo cau hinh do
            (
              exists(/databases/$(database)/documents/artifacts/$(appId)/roles_config/$(roleId)) &&
              'permissions' in get(/databases/$(database)/documents/artifacts/$(appId)/roles_config/$(roleId)).data &&
              get(/databases/$(database)/documents/artifacts/$(appId)/roles_config/$(roleId)).data.permissions is list &&
              get(/databases/$(database)/documents/artifacts/$(appId)/roles_config/$(roleId)).data.permissions.hasAny([permission])
            )
            ||
            // 2. Fallback: CHI AP DUNG khi roles_config chua duoc tao (bi trong)
            (
              !exists(/databases/$(database)/documents/artifacts/$(appId)/roles_config/$(roleId)) &&
              (
                ['inventory_view', 'standard_view', 'sop_view', 'recipe_view', 'standard_request'].hasAny([permission]) ||
                (roleId == 'role_lab_technician' && ['inventory_edit', 'batch_run'].hasAny([permission])) ||
                (roleId == 'role_qc_lead' && ['inventory_edit', 'standard_edit', 'standard_approve', 'standard_log_view', 'standard_log_delete', 'recipe_edit', 'sop_edit', 'sop_approve', 'batch_run', 'report_view'].hasAny([permission]))
              )
            )
          )
        );
    }

    // 6. Kiem tra User co mot quyen cu the nao do khong (Tuyet doi khong gay crash neu user profile chua ton tai)
    function hasPermission(appId, permission) {
      return userExists(appId) && evaluateUserPermission(appId, getUserProfile(appId), permission);
    }

    // Operational data must follow the same active-role boundary as the client.
    // In particular, viewer/pending profiles do not gain write access through
    // permissive signed-in fallbacks.
    function isActiveUser(appId) {
      return userExists(appId) &&
        ['manager', 'staff'].hasAny([getUserProfile(appId).get('role', 'pending')]);
    }

    function canUseSopWorkspace(appId) {
      return isActiveUser(appId) && hasPermission(appId, 'sop_view');
    }

    function canEditResults(appId) {
      return isActiveUser(appId) &&
        (hasPermission(appId, 'batch_run') || hasPermission(appId, 'sop_approve'));
    }

    function isCurrentActorName(appId, value) {
      let profile = getUserProfile(appId);
      return value is string && (
        value == profile.get('displayName', '') ||
        value == profile.get('email', '') ||
        value == request.auth.token.get('email', '') ||
        value == request.auth.uid
      );
    }

    function canCreateAuditLog(appId) {
      return isManager(appId) || (
        isActiveUser(appId) && (
          hasPermission(appId, 'inventory_edit') ||
          hasPermission(appId, 'standard_request') ||
          hasPermission(appId, 'standard_edit') ||
          hasPermission(appId, 'standard_approve') ||
          hasPermission(appId, 'standard_log_delete') ||
          hasPermission(appId, 'recipe_edit') ||
          hasPermission(appId, 'sop_edit') ||
          hasPermission(appId, 'sop_approve') ||
          hasPermission(appId, 'batch_run')
        )
      );
    }

    // Activity V2 action groups mirror ACTIVITY_ACTION_REGISTRY. Keep these
    // lists explicit so Rules fail closed when a new action is added without
    // a corresponding security classification.
    function isResultViewActivityAction(action) {
      return [
        'PUBLISH_RESULT_REPORT', 'REVERT_RESULT_DRAFT', 'DIRECT_APPROVE',
        'APPROVE_REQUEST', 'REVOKE_APPROVE', 'REVOKE_AND_REJECT', 'PRINT',
        'PRINT_JOB_RECORD'
      ].hasAny([action]);
    }

    function isResultOperatorActivityAction(action) {
      return [
        'SAVE_RESULT_DRAFT', 'RESET_RESULT_DATA', 'RESTORE_RESULT_BACKUP',
        'RESTORE_RESULT_VERSION', 'RECONCILE_RESULT_STATUS', 'UNLOCK_RESULT_EDIT',
        'CREATE_VIRTUAL_MASTER', 'DELETE_VIRTUAL_MASTER', 'DIRECT_APPROVE_PLAN',
        'EDIT_REQUEST'
      ].hasAny([action]);
    }

    function isInventoryViewActivityAction(action) {
      return [
        'CREATE_ITEM', 'UPDATE_INFO', 'STOCK_IN', 'STOCK_OUT',
        'INVENTORY_LOW_STOCK'
      ].hasAny([action]);
    }

    function isInventoryOperatorActivityAction(action) {
      return ['SOFT_DELETE_ITEM', 'RESTORE_ITEM', 'BULK_ZERO'].hasAny([action]);
    }

    function isStandardViewActivityAction(action) {
      return [
        'CREATE_STANDARD', 'UPDATE_STANDARD', 'UPDATE_STOCK', 'STANDARD_LOW_STOCK',
        'BULK_UPDATE_STANDARD_TAGS', 'REQUEST_COA', 'UPLOAD_STANDARD_COA',
        'REQUEST_STANDARD', 'CREATE_STANDARD_REQUEST', 'UPDATE_STANDARD_REQUEST',
        'ASSIGN_STANDARD', 'APPROVE_STANDARD_REQUEST', 'REJECT_STANDARD_REQUEST',
        'REPORT_RETURN_STANDARD', 'RETURN_STANDARD', 'LOG_USAGE_STANDARD'
      ].hasAny([action]);
    }

    function isStandardOperatorActivityAction(action) {
      return [
        'RESTORE_STANDARD', 'SOFT_DELETE_BATCH', 'NORMALIZE_STANDARD_NAMES',
        'UNDO_NORMALIZE_STANDARD_NAMES', 'RELEASE_STANDARD_INTERNAL_ID',
        'IMPORT_STANDARDS', 'IMPORT_STANDARD_USAGE_LOGS', 'BACKFILL_USAGE_LOG',
        'DELETE_USAGE_LOG', 'HARD_DELETE_REQUEST', 'CREATE_STANDARD_TAG',
        'UPDATE_STANDARD_TAG', 'SOFT_DELETE_STANDARD_TAG', 'RESTORE_STANDARD_TAG',
        'IMPORT_ACCREDITATION_TAG_SEED', 'ARCHIVE_ACCREDITATION_TAG_SEED'
      ].hasAny([action]);
    }

    function isSystemAdminActivityAction(action) {
      return [
        'MAINTENANCE_ON', 'MAINTENANCE_OFF', 'POST_SYSTEM_UPDATE',
        'SHOW_LOCKED_ON', 'SHOW_LOCKED_OFF'
      ].hasAny([action]);
    }

    function isSupportedActivityAction(action) {
      return isResultViewActivityAction(action) ||
        isResultOperatorActivityAction(action) ||
        isInventoryViewActivityAction(action) ||
        isInventoryOperatorActivityAction(action) ||
        isStandardViewActivityAction(action) ||
        isStandardOperatorActivityAction(action) ||
        isSystemAdminActivityAction(action);
    }

    function validActivityClassification(data) {
      let action = data.get('action', '');
      let module = data.get('module', '');
      let audience = data.get('audience', '');
      let auditClass = data.get('auditClass', '');
      return (
        isResultViewActivityAction(action) &&
        module == 'RESULT' && audience == 'RESULT_VIEW' && auditClass == 'BUSINESS'
      ) || (
        isResultOperatorActivityAction(action) &&
        module == 'RESULT' && audience == 'RESULT_OPERATOR' && auditClass == 'BUSINESS'
      ) || (
        isInventoryViewActivityAction(action) &&
        module == 'INVENTORY' && audience == 'INVENTORY_VIEW' && auditClass == 'BUSINESS'
      ) || (
        isInventoryOperatorActivityAction(action) &&
        module == 'INVENTORY' && audience == 'INVENTORY_OPERATOR' && auditClass == 'BUSINESS'
      ) || (
        isStandardViewActivityAction(action) &&
        module == 'STANDARD' && audience == 'STANDARD_VIEW' && auditClass == 'BUSINESS'
      ) || (
        isStandardOperatorActivityAction(action) &&
        module == 'STANDARD' && audience == 'STANDARD_OPERATOR' && auditClass == 'BUSINESS'
      ) || (
        isSystemAdminActivityAction(action) &&
        module == 'SYSTEM' && audience == 'SYSTEM_ADMIN' && auditClass == 'SYSTEM'
      );
    }

    function isNormalActivityAction(action) {
      return [
        'SAVE_RESULT_DRAFT', 'RESTORE_RESULT_BACKUP', 'RECONCILE_RESULT_STATUS',
        'CREATE_VIRTUAL_MASTER', 'DIRECT_APPROVE_PLAN', 'EDIT_REQUEST', 'CREATE_ITEM',
        'UPDATE_INFO', 'STOCK_IN', 'STOCK_OUT', 'CREATE_STANDARD', 'UPDATE_STANDARD',
        'UPDATE_STOCK', 'BULK_UPDATE_STANDARD_TAGS', 'UPDATE_STANDARD_REQUEST',
        'LOG_USAGE_STANDARD', 'CREATE_STANDARD_TAG', 'UPDATE_STANDARD_TAG', 'PRINT',
        'PRINT_JOB_RECORD'
      ].hasAny([action]);
    }

    function isImportantActivityAction(action) {
      return [
        'PUBLISH_RESULT_REPORT', 'REVERT_RESULT_DRAFT', 'RESTORE_RESULT_VERSION',
        'UNLOCK_RESULT_EDIT', 'DIRECT_APPROVE', 'APPROVE_REQUEST', 'RESTORE_ITEM',
        'RESTORE_STANDARD', 'NORMALIZE_STANDARD_NAMES', 'RELEASE_STANDARD_INTERNAL_ID',
        'IMPORT_STANDARDS', 'IMPORT_STANDARD_USAGE_LOGS', 'REQUEST_COA',
        'UPLOAD_STANDARD_COA', 'REQUEST_STANDARD', 'CREATE_STANDARD_REQUEST',
        'ASSIGN_STANDARD', 'APPROVE_STANDARD_REQUEST', 'REPORT_RETURN_STANDARD',
        'RETURN_STANDARD', 'BACKFILL_USAGE_LOG', 'SOFT_DELETE_STANDARD_TAG',
        'RESTORE_STANDARD_TAG', 'IMPORT_ACCREDITATION_TAG_SEED',
        'ARCHIVE_ACCREDITATION_TAG_SEED', 'MAINTENANCE_OFF', 'POST_SYSTEM_UPDATE',
        'SHOW_LOCKED_ON', 'SHOW_LOCKED_OFF'
      ].hasAny([action]);
    }

    function isWarningActivityAction(action) {
      return [
        'RESET_RESULT_DATA', 'DELETE_VIRTUAL_MASTER', 'REVOKE_APPROVE',
        'REVOKE_AND_REJECT', 'SOFT_DELETE_ITEM', 'BULK_ZERO',
        'INVENTORY_LOW_STOCK', 'STANDARD_LOW_STOCK', 'SOFT_DELETE_BATCH',
        'UNDO_NORMALIZE_STANDARD_NAMES', 'REJECT_STANDARD_REQUEST',
        'DELETE_USAGE_LOG', 'HARD_DELETE_REQUEST', 'MAINTENANCE_ON'
      ].hasAny([action]);
    }

    function validActivityImportance(action, importance) {
      return (importance == 'NORMAL' && isNormalActivityAction(action)) ||
        (importance == 'IMPORTANT' && isImportantActivityAction(action)) ||
        (importance == 'WARNING' && isWarningActivityAction(action));
    }

    function isHiddenActivityAction(action) {
      return [
        'RECONCILE_RESULT_STATUS', 'CREATE_STANDARD_TAG', 'UPDATE_STANDARD_TAG',
        'IMPORT_ACCREDITATION_TAG_SEED', 'ARCHIVE_ACCREDITATION_TAG_SEED',
        'PRINT', 'PRINT_JOB_RECORD'
      ].hasAny([action]);
    }

    function validActivityVisibility(action, activityVisible) {
      return activityVisible is bool && activityVisible == !isHiddenActivityAction(action);
    }

    function canBePublicTraceableActivityAction(action) {
      return [
        'DIRECT_APPROVE', 'DIRECT_APPROVE_PLAN', 'APPROVE_REQUEST',
        'EDIT_REQUEST', 'CREATE_VIRTUAL_MASTER'
      ].hasAny([action]);
    }

    function validActivityOptionalFields(data) {
      return (!('targetType' in data) || (
          data.targetType is string && data.targetType.size() > 0 && data.targetType.size() <= 100
        )) &&
        (!('targetId' in data) || (
          data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 300
        )) &&
        (!('targetName' in data) || (
          data.targetName is string && data.targetName.size() > 0 && data.targetName.size() <= 500
        )) &&
        (!('requestId' in data) || (
          data.requestId is string && data.requestId.size() > 0 && data.requestId.size() <= 300
        )) &&
        (!('actionUrl' in data) || (
          data.actionUrl is string && data.actionUrl.size() > 0 && data.actionUrl.size() <= 1000
        )) &&
        (!('metadata' in data) || (
          data.metadata is map && data.metadata.keys().size() <= 40
        )) &&
        (!('printable' in data) || data.printable is bool) &&
        (!('printJobId' in data) || (
          data.printJobId is string && data.printJobId.size() > 0 && data.printJobId.size() <= 300
        ));
    }

    function validCanonicalActivityCreate(appId, logId, data) {
      let eventId = data.get('eventId', '');
      let action = data.get('action', '');
      let actorName = data.get('actorName', '');
      let publicTraceable = data.get('publicTraceable', false);
      return isActiveUser(appId) &&
        data.get('schemaVersion', 0) == 2 &&
        data.get('id', '') == logId &&
        eventId is string && eventId == logId && eventId.size() > 0 && eventId.size() <= 300 &&
        data.get('actorUid', '') is string && data.get('actorUid', '') == request.auth.uid &&
        actorName is string && actorName.size() > 0 && actorName.size() <= 200 &&
        isCurrentActorName(appId, actorName) &&
        data.get('user', '') == actorName &&
        action is string && action.size() > 0 && action.size() <= 100 &&
        isSupportedActivityAction(action) &&
        validActivityClassification(data) &&
        validActivityImportance(action, data.get('importance', '')) &&
        validActivityVisibility(action, data.get('activityVisible', null)) &&
        data.get('details', '') is string &&
        data.get('details', '').size() > 0 && data.get('details', '').size() <= 2000 &&
        publicTraceable is bool &&
        (!publicTraceable || (
          data.get('auditClass', '') == 'BUSINESS' && canBePublicTraceableActivityAction(action) &&
          data.get('requestId', '') is string && data.get('requestId', '').size() > 0 &&
          data.get('requestId', '').size() <= 300 && data.get('targetType', '') == 'REQUEST'
        )) &&
        data.timestamp == request.time &&
        (!('lastUpdated' in data) || data.lastUpdated == request.time) &&
        validActivityOptionalFields(data) &&
        (!isSystemAdminActivityAction(action) || isManager(appId));
    }

    function canReadActivityAudience(appId, data) {
      let audience = data.get('audience', '');
      return isActiveUser(appId) && data.get('activityVisible', false) == true && (
        isManager(appId) ||
        (audience == 'RESULT_VIEW' && (
          hasPermission(appId, 'sop_view') ||
          hasPermission(appId, 'batch_run') ||
          hasPermission(appId, 'sop_approve')
        )) ||
        (audience == 'RESULT_OPERATOR' && (
          hasPermission(appId, 'batch_run') || hasPermission(appId, 'sop_approve')
        )) ||
        (audience == 'INVENTORY_VIEW' && (
          hasPermission(appId, 'inventory_view') || hasPermission(appId, 'inventory_edit')
        )) ||
        (audience == 'INVENTORY_OPERATOR' && hasPermission(appId, 'inventory_edit')) ||
        (audience == 'STANDARD_VIEW' && (
          hasPermission(appId, 'standard_view') ||
          hasPermission(appId, 'standard_edit') ||
          hasPermission(appId, 'standard_approve') ||
          hasPermission(appId, 'standard_log_view')
        )) ||
        (audience == 'STANDARD_OPERATOR' && (
          hasPermission(appId, 'standard_edit') || hasPermission(appId, 'standard_approve')
        )) ||
        (audience == 'SYSTEM_ADMIN' && hasPermission(appId, 'user_manage'))
      );
    }

    function canReadAuditClass(appId, data) {
      let auditClass = data.get('auditClass', '');
      return isActiveUser(appId) && (
        isManager(appId) ||
        (auditClass == 'BUSINESS' && hasPermission(appId, 'report_view')) ||
        (auditClass == 'SYSTEM' && hasPermission(appId, 'user_manage'))
      );
    }

    function canReadPersonalPrintableLog(appId, data) {
      return isActiveUser(appId) &&
        data.get('printable', false) == true &&
        (
          data.get('actorUid', '') == request.auth.uid ||
          // Compatibility-only fallback. This remains broad until the
          // legacy printable documents are backfilled and the name listener
          // is removed; V2 readers use actorUid instead.
          isCurrentActorName(appId, data.get('user', ''))
        );
    }

    function canReadPublicTraceability(data) {
      return data.get('publicTraceable', false) == true &&
        data.get('auditClass', '') == 'BUSINESS' &&
        data.get('requestId', '') is string && data.get('requestId', '').size() > 0 &&
        data.get('requestId', '').size() <= 300 && data.get('targetType', '') == 'REQUEST';
    }

    function canGetGlobalLog(appId, data) {
      return canReadPublicTraceability(data) ||
        canReadActivityAudience(appId, data) ||
        canReadAuditClass(appId, data) ||
        canReadPersonalPrintableLog(appId, data);
    }

    function canListGlobalLog(appId, data) {
      return canReadActivityAudience(appId, data) ||
        canReadAuditClass(appId, data) ||
        canReadPersonalPrintableLog(appId, data);
    }

    function validRequestCreate(appId, data) {
      return canEditResults(appId) &&
        data.get('sopId', '') is string && data.get('sopId', '').size() > 0 &&
        data.get('sopName', '') is string && data.get('sopName', '').size() > 0 &&
        data.get('items', []) is list &&
        ['pending', 'approved'].hasAny([data.get('status', '')]) &&
        isCurrentActorName(appId, data.get('user', '')) &&
        data.timestamp == request.time &&
        data.lastUpdated == request.time &&
        (data.get('status', '') != 'approved' || data.approvedAt == request.time);
    }

    function validResultLifecycleTransition() {
      let fromStatus = resource.data.get('status', '');
      let toStatus = request.resource.data.get('status', fromStatus);
      return toStatus == fromStatus ||
        (fromStatus == 'approved' && toStatus == 'draft') ||
        (fromStatus == 'draft' && ['draft', 'completed'].hasAny([toStatus])) ||
        (fromStatus == 'completed' && ['draft', 'completed'].hasAny([toStatus]));
    }

    function validResultUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let resultFields = [
        'status', 'resultStatusReason', 'analysisResultSummary', 'analysisResult',
        'parentMasterId', 'lastUpdated'
      ];
      return changed.hasOnly(resultFields) && validResultLifecycleTransition() &&
        (!changed.hasAny(['status']) || request.resource.data.get('resultStatusReason', '') is string);
    }

    function validLockUpdate(appId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let lockFields = ['lockedBy', 'lockedByName', 'lockedAt', 'lastActiveAt', 'lastUpdated'];
      let acquireLock = changed.hasOnly(lockFields) && changed.hasAny(['lockedBy']) &&
        request.resource.data.get('lockedBy', '') == request.auth.token.get('email', '') &&
        isCurrentActorName(appId, request.resource.data.get('lockedByName', ''));
      let heartbeat = changed.hasOnly(['lastActiveAt', 'lastUpdated']) &&
        resource.data.get('lockedBy', '') == request.auth.token.get('email', '');
      let releaseLock = changed.hasOnly(lockFields) &&
        resource.data.get('lockedBy', '') == request.auth.token.get('email', '') &&
        !('lockedBy' in request.resource.data);
      return acquireLock || heartbeat || releaseLock;
    }

    function validVirtualMasterUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let repairVirtualMaster = resource.data.get('isVirtualMaster', false) == true &&
        changed.hasOnly(['targetIds', 'targetNames', 'sampleTargetMap', 'lastUpdated']);
      let linkVirtualMaster = changed.hasOnly(['parentMasterId', 'lastUpdated']);
      let deleteVirtualMaster = resource.data.get('isVirtualMaster', false) == true &&
        changed.hasOnly(['_isDeleted', 'status', 'lastUpdated']) &&
        request.resource.data.get('_isDeleted', false) == true &&
        request.resource.data.get('status', '') == 'REJECTED';
      return repairVirtualMaster || linkVirtualMaster || deleteVirtualMaster;
    }

    function validBatchRequestUpdate(appId) {
      return isActiveUser(appId) && hasPermission(appId, 'batch_run') &&
        (validResultUpdate() || validLockUpdate(appId) || validVirtualMasterUpdate());
    }

    function canOperateStandards(appId) {
      return hasPermission(appId, 'standard_edit') || hasPermission(appId, 'standard_approve');
    }

    function canRollbackStandardLogs(appId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (hasPermission(appId, 'standard_edit') || hasPermission(appId, 'standard_log_delete')) &&
        changed.hasOnly(['_isDeleted', 'rolledBackAt', 'rolledBackBy', 'lastUpdated']) &&
        request.resource.data.get('_isDeleted', false) == true &&
        request.resource.data.lastUpdated == request.time;
    }

    function validRequesterUsageJournalData(appId, stdId, reqId, logId, stockDelta, data) {
      let standard = get(/databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId)).data;
      let standardRequest = get(/databases/$(database)/documents/artifacts/$(appId)/standard_requests/$(reqId)).data;
      let stockUnit = standard.get('unit', 'mg');
      return data.keys().hasAll([
          'id', 'date', 'timestamp', 'user', 'userId', 'amount_used', 'unit',
          'normalized_amount', 'normalized_unit', 'purpose', 'standardId',
          'standardName', 'requestId', 'lastUpdated'
        ]) &&
        data.keys().hasOnly([
          'id', 'date', 'timestamp', 'user', 'userId', 'amount_used', 'unit',
          'normalized_amount', 'normalized_unit', 'purpose', 'standardId',
          'standardName', 'lotNumber', 'cas_number', 'internalId', 'manufacturer',
          'requestId', 'lastUpdated'
        ]) &&
        data.id == logId &&
        data.requestId == reqId &&
        data.standardId == stdId &&
        data.userId == request.auth.uid &&
        data.user == standardRequest.get('requestedByName', '') &&
        data.date is string && data.date.size() > 0 &&
        data.timestamp is number &&
        data.amount_used is number && data.amount_used > 0 &&
        data.unit is string && data.unit.size() > 0 &&
        data.normalized_amount is number && data.normalized_amount == stockDelta &&
        data.normalized_unit == stockUnit &&
        data.purpose is string && data.purpose.size() > 0 &&
        data.standardName == standard.get('name', '') &&
        (!('lotNumber' in data) || data.lotNumber == standard.get('lot_number', '')) &&
        data.lastUpdated == request.time;
    }

    // Security protocol for requester usage. Every stock deduction, request
    // aggregate increment and both journal copies must participate in the same
    // atomic write and share one correlation id.
    function validRequesterUsageStateTransition(appId, stdId, logId) {
      let standardBefore = get(/databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId));
      let standardAfter = getAfter(/databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId));
      let reqId = standardBefore.data.get('current_request_id', '');
      let requestBefore = get(/databases/$(database)/documents/artifacts/$(appId)/standard_requests/$(reqId));
      let requestAfter = getAfter(/databases/$(database)/documents/artifacts/$(appId)/standard_requests/$(reqId));
      let stockDelta = standardBefore.data.get('current_amount', 0) - standardAfter.data.get('current_amount', 0);
      let subLogAfter = getAfter(/databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId)/logs/$(logId));
      let globalLogAfter = getAfter(/databases/$(database)/documents/artifacts/$(appId)/standard_usages/$(logId));
      return logId is string && logId.size() > 0 &&
        reqId is string && reqId.size() > 0 &&
        standardBefore.data.get('status', '') == 'IN_USE' &&
        standardBefore.data.get('current_holder_uid', '') == request.auth.uid &&
        stockDelta > 0 &&
        standardAfter.data.get('current_amount', -1) >= 0 &&
        standardAfter.data.get('current_holder_uid', '') == request.auth.uid &&
        standardAfter.data.get('current_request_id', '') == reqId &&
        requestBefore.data.get('requestedBy', '') == request.auth.uid &&
        requestBefore.data.get('standardId', '') == stdId &&
        requestBefore.data.get('status', '') == 'IN_PROGRESS' &&
        requestBefore.data.get('totalAmountUsed', -1) is number &&
        requestAfter.data.get('requestedBy', '') == request.auth.uid &&
        requestAfter.data.get('standardId', '') == stdId &&
        requestAfter.data.get('status', '') == 'IN_PROGRESS' &&
        requestAfter.data.get('totalAmountUsed', -1) == requestBefore.data.get('totalAmountUsed', 0) + stockDelta &&
        requestAfter.data.get('lastUsageLogId', '') == logId &&
        requestBefore.data.get('lastUsageLogId', '') != logId &&
        subLogAfter.data.get('id', '') == logId &&
        subLogAfter.data.get('requestId', '') == reqId &&
        subLogAfter.data.get('standardId', '') == stdId &&
        subLogAfter.data.get('userId', '') == request.auth.uid &&
        subLogAfter.data.get('normalized_amount', -1) == stockDelta &&
        globalLogAfter.data.get('id', '') == logId &&
        globalLogAfter.data.get('requestId', '') == reqId &&
        globalLogAfter.data.get('standardId', '') == stdId &&
        globalLogAfter.data.get('userId', '') == request.auth.uid &&
        globalLogAfter.data.get('normalized_amount', -1) == stockDelta;
    }

    function validRequesterUsageJournalCreate(appId, stdId, logId, data) {
      let standardBefore = get(/databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId));
      let standardAfter = getAfter(/databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId));
      let reqId = standardBefore.data.get('current_request_id', '');
      let stockDelta = standardBefore.data.get('current_amount', 0) - standardAfter.data.get('current_amount', 0);
      // The companion standard update is the full protocol gate. Journal rules
      // only need to prove that a real stock deduction exists in this atomic
      // write and that this journal exactly describes that deduction. This
      // keeps the four-write protocol below Firestore's expression limit.
      return stockDelta > 0 &&
        validRequesterUsageJournalData(appId, stdId, reqId, logId, stockDelta, data);
    }

    // Đường tăng monthly_stats dùng atomic field transforms; đường giảm vẫn dùng
    // transaction để clamp counter về 0. Cả hai đều cần quyền vận hành tương ứng.
    function canUpdateStats(appId) {
      return hasPermission(appId, 'sop_approve') || hasPermission(appId, 'batch_run');
    }

    // Tag arrays are optional for backward compatibility, but whenever they
    // are present they must remain bounded lists. The client performs strict
    // canonical-key validation; Rules enforce the non-bypassable shape/size
    // invariant at the database boundary.
    function noDerivedDeviceKeys(value) {
      return value is list && !value.hasAny([
        'device:gc', 'device:gcecd', 'device:gcms', 'device:gcmsms',
        'device:gchrms', 'device:lcmsms', 'device:icpms', 'device:hplc',
        'device:hplcuvvis', 'device:hplcfld', 'device:hplcdad', 'device:hplcpda',
        'device:ic', 'device:uvvis', 'device:aasflame', 'device:elisa'
      ]);
    }

    function validReturnTagArray(data) {
      return !('sopTags' in data) || (data.sopTags is list && data.sopTags.size() <= 10 && noDerivedDeviceKeys(data.sopTags));
    }

    function validStandardTagArray(data) {
      return !('sop_tags' in data) || (data.sop_tags is list && data.sop_tags.size() <= 100 && noDerivedDeviceKeys(data.sop_tags));
    }

    function validFinalReturnTagArray(data) {
      return !('finalSopTags' in data) || (data.finalSopTags is list && data.finalSopTags.size() <= 10 && noDerivedDeviceKeys(data.finalSopTags));
    }

    function validCatalogName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function validManualCatalogItem(data) {
      return validCatalogName(data) && data.origin == 'MANUAL' && data.locked == false &&
        !data.keys().hasAny(['methodName', 'methodCode', 'deviceCodes', 'sourceDecision', 'sourceLabCode', 'sourceDocument', 'sourceSha256', 'seedVersion']);
    }

    function validAccreditationCatalogItem(data) {
      return validCatalogName(data) &&
        data.origin == 'ACCREDITATION_SCOPE' && data.locked == true &&
        data.templateKind == 'TEST_METHOD' &&
        data.name is string && data.code == data.name && data.methodCode == data.name &&
        data.methodCode.matches('^NAFI6/H-[0-9]+\\.[0-9]+$') &&
        data.methodName is string && data.methodName.size() > 0 && data.methodName.size() <= 300 &&
        data.sourceAgency is string && data.sourceAgency.size() > 0 &&
        data.sourceDecision is string && data.sourceDecision.size() > 0 &&
        data.sourceLabCode is string && data.sourceLabCode.size() > 0 &&
        data.sourceDocument is string && data.sourceDocument.size() > 0 &&
        data.sourceSha256 is string && data.sourceSha256.matches('^[A-Fa-f0-9]{64}$') &&
        data.sourceValidFrom is string && data.sourceValidFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.sourceValidTo is string && data.sourceValidTo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.sourcePages is string && data.sourcePages.size() <= 100 &&
        data.deviceCodes is list && data.deviceCodes.size() <= 5 &&
        data.deviceCodes.hasOnly(['GC', 'GCECD', 'GCMS', 'GCMSMS', 'GCHRMS', 'LCMSMS', 'ICPMS', 'HPLC', 'HPLCUVVIS', 'HPLCFLD', 'HPLCDAD', 'HPLCPDA', 'IC', 'UVVIS', 'AASFLAME', 'ELISA']);
    }

    // --- CAU HINH HE THONG VA VAI TRO ---
    
    // Moi nguoi dung da dang nhap deu co the doc thong tin co ban de hien thi avatar,
    // nhung chi nguoi dung do hoac Manager moi duoc phep chinh sua
    match /artifacts/{appId}/users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'pending' &&
        request.resource.data.get('permissions', []).size() == 0;
      allow update: if isManager(appId) || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'photoURL', 'avatarStyle', 'fcmTokens', 'email', 'displayName', 'lastSeen', 'lastLogin',
          'localPasswordConfigured', 'localPasswordConfiguredAt', 'lastPasswordChangedAt'
        ]) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastPasswordChangedAt']) ||
          request.resource.data.lastPasswordChangedAt == request.time
        )
      );
      allow delete: if isManager(appId);
    }

    // Per-user Activity UI marker. This is deliberately separate from Bell
    // notification read state and never grants Manager cross-user access.
    match /artifacts/{appId}/user_preferences/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['lastActivitySeenAt']) &&
        request.resource.data.lastActivitySeenAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivitySeenAt']) &&
        request.resource.data.lastActivitySeenAt == request.time;
      allow delete: if false;
    }

    // Cau hinh nhom vai tro dong (Roles Config)
    match /artifacts/{appId}/roles_config/{roleId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId);
    }

    // Metadata he thong va Cau hinh chung
    match /artifacts/{appId}/system/{docId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId);
    }
    match /artifacts/{appId}/config/{docId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId);
    }
    match /artifacts/{appId}/sample_description_master/{itemId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId) || hasPermission(appId, 'sop_edit');
    }
    match /artifacts/{appId}/system_updates/{docId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId);
    }
    match /artifacts/{appId}/stats/{docId} {
      allow read: if hasPermission(appId, 'report_view');
      allow write: if canUpdateStats(appId);
    }
    match /artifacts/{appId}/monthly_stats/{docId} {
      allow read: if hasPermission(appId, 'report_view') || canUpdateStats(appId);
      allow write: if canUpdateStats(appId);
    }
    match /artifacts/{appId}/notifications/{docId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if false; // Chi Firebase Admin trong /api/notifications duoc tao
      allow update: if isSignedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead == true;
      allow delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }
    match /artifacts/{appId}/auth_sessions/{sessionId} {
      // [SECURITY FIX 2026-07-30] P0: Collection này KHÔNG cho phép client trực tiếp đọc/ghi.
      // Mọi thao tác tạo/duyệt/poll session đi qua Admin SDK tại /api/qr/* (Vercel serverless).
      // Sau khi QR login redesign hoàn tất, rule này sẽ được mở lại với scope tối thiểu theo uid.
      allow read, write: if false;
    }

    // --- CAC MODULE NGHIEP VU ---

    // MODULE KHO (INVENTORY)
    match /artifacts/{appId}/inventory/{itemId} {
      allow read: if hasPermission(appId, 'inventory_view');
      allow create, delete: if hasPermission(appId, 'inventory_edit');
      allow update: if hasPermission(appId, 'inventory_edit') || (
        hasPermission(appId, 'batch_run') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastUpdated']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock <= resource.data.stock
      );
      
      // Lich su tieu hao / thay doi kho
      match /history/{histId} {
        allow read: if hasPermission(appId, 'inventory_view');
        allow write: if hasPermission(appId, 'inventory_edit');
      }
    }

    // MODULE CHUAN DOI CHIEU (REFERENCE STANDARDS)
    match /artifacts/{appId}/reference_standards/{stdId} {
      function canApproveReferenceStandardUpdate(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return hasPermission(appId, 'standard_approve') &&
          validStandardTagArray(request.resource.data) &&
          changed.hasOnly([
            'status', 'current_holder', 'current_holder_uid', 'current_request_id',
            'has_pending_request', 'restock_requested', 'current_amount', 'date_opened', 'sop_tags', 'lastUpdated'
          ]) &&
          request.resource.data.current_amount >= 0;
      }

      function canRequesterUpdateReferenceStandard(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let requestBorrow = changed.hasOnly(['has_pending_request', 'lastUpdated']) &&
          request.resource.data.has_pending_request == true;
        let requestRestock = changed.hasOnly(['restock_requested', 'lastUpdated']) &&
          request.resource.data.restock_requested == true;
        let requestCoa = changed.hasOnly(['coa_requested_by', 'lastUpdated']) &&
          request.resource.data.coa_requested_by == request.auth.uid;
        return hasPermission(appId, 'standard_request') && (
          requestBorrow || requestRestock || requestCoa ||
          (changed.hasAny(['current_amount']) &&
            resource.data.get('current_holder_uid', '') == request.auth.uid &&
            validRequesterUsageTransaction(appId))
        );
      }

      function validRequesterUsageTransaction(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let reqId = resource.data.get('current_request_id', '');
        let reqAfter = getAfter(/databases/$(database)/documents/artifacts/$(appId)/standard_requests/$(reqId));
        let usageLogId = reqAfter.data.get('lastUsageLogId', '');
        return resource.data.get('current_holder_uid', '') == request.auth.uid &&
          changed.hasOnly(['status', 'current_amount', 'date_opened', 'lastUpdated']) &&
          request.resource.data.get('current_amount', -1) is number &&
          request.resource.data.get('current_amount', -1) >= 0 &&
          request.resource.data.get('status', '') ==
            (request.resource.data.get('current_amount', -1) == 0 ? 'DEPLETED' : 'IN_USE') &&
          request.resource.data.lastUpdated == request.time &&
          validRequesterUsageStateTransition(appId, stdId, usageLogId);
      }

      function canRollbackReferenceStandardUpdate(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return hasPermission(appId, 'standard_log_delete') &&
          changed.hasOnly([
            'status', 'current_holder', 'current_holder_uid', 'current_request_id',
            'has_pending_request', 'current_amount', 'lastUpdated'
          ]) &&
          request.resource.data.current_amount >= resource.data.current_amount;
      }

      // A standard_edit client may change ordinary metadata, but cannot
      // silently move a physical record to another reusable code or mutate
      // the lifecycle ledger. The audited sync tool is the only repair path
      // for a legacy missing/invalid code.
      function canEditReferenceStandardMetadata(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return hasPermission(appId, 'standard_edit') &&
          validStandardTagArray(request.resource.data) &&
          !changed.hasAny([
            'internal_id', 'lifecycle_status', 'internal_id_assigned_at',
            'internal_id_released_at', 'internal_id_release_reason',
            'internal_id_assignment_sequence'
          ]) &&
          request.resource.data.get('internal_id', '') == resource.data.get('internal_id', '');
      }

      function canRepairReferenceStandardInternalId(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let code = request.resource.data.get('internal_id', '');
        let registryPath = /databases/$(database)/documents/artifacts/$(appId)/standard_code_registry/$(code);
        let remainsCurrent = request.resource.data.get('_isDeleted', false) != true &&
          request.resource.data.get('status', '') != 'DELETED' &&
          request.resource.data.get('lifecycle_status', 'ACTIVE') == 'ACTIVE';
        return hasPermission(appId, 'standard_edit') &&
          changed.hasOnly(['internal_id', 'search_key', 'lastUpdated']) &&
          !validInternalId(resource.data.get('internal_id', '')) &&
          validInternalId(code) &&
          request.resource.data.lastUpdated == request.time &&
          (!remainsCurrent || (
            existsAfter(registryPath) &&
            getAfter(registryPath).data.get('status', '') == 'ASSIGNED' &&
            getAfter(registryPath).data.get('internal_id', '') == code &&
            getAfter(registryPath).data.get('currentStandardId', '') == stdId
          ));
      }

      function noOpenStandardWorkflow(data) {
        return data.get('status', '') != 'IN_USE' &&
          data.get('current_holder', '') == '' &&
          data.get('current_holder_uid', '') == '' &&
          data.get('current_request_id', '') == '' &&
          data.get('has_pending_request', false) == false;
      }

      function canReleaseReferenceStandardInternalId(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let code = resource.data.get('internal_id', '');
        let registryPath = /databases/$(database)/documents/artifacts/$(appId)/standard_code_registry/$(code);
        return hasPermission(appId, 'standard_edit') &&
          changed.hasOnly([
            'lifecycle_status', 'internal_id_released_at',
            'internal_id_release_reason', 'lastUpdated'
          ]) &&
          validInternalId(code) &&
          request.resource.data.get('lifecycle_status', '') == 'RELEASED' &&
          noOpenStandardWorkflow(request.resource.data) &&
          request.resource.data.lastUpdated == request.time &&
          existsAfter(registryPath) &&
          (
            (getAfter(registryPath).data.get('status', '') == 'AVAILABLE' &&
              getAfter(registryPath).data.get('lastReleasedStandardId', '') == stdId) ||
            (getAfter(registryPath).data.get('status', '') == 'ASSIGNED' &&
              getAfter(registryPath).data.get('currentStandardId', '') != stdId &&
              getAfter(registryPath).data.get('lastReleasedStandardId', '') == stdId)
          );
      }

      function canUpdateReferenceStandard(appId) {
        return canRequesterUpdateReferenceStandard(appId) ||
          canRepairReferenceStandardInternalId(appId) ||
          canReleaseReferenceStandardInternalId(appId) ||
          canEditReferenceStandardMetadata(appId) ||
          canApproveReferenceStandardUpdate(appId) ||
          canRollbackReferenceStandardUpdate(appId);
      }

      allow read: if hasPermission(appId, 'standard_view');
      allow create: if hasPermission(appId, 'standard_edit') &&
        validStandardTagArray(request.resource.data) &&
        validInternalId(request.resource.data.get('internal_id', ''));
      allow update: if canUpdateReferenceStandard(appId);
      allow delete: if hasPermission(appId, 'standard_delete') || isManager(appId);

      // Nhat ky muon/su dung chat chuan chi tiet
      match /logs/{logId} {
        allow read: if hasPermission(appId, 'standard_view');
        allow create: if validRequesterUsageJournalCreate(appId, stdId, logId, request.resource.data) ||
          canOperateStandards(appId);
        allow update: if canRepairNestedStandardUsageSnapshot(appId, stdId) ||
          canRollbackStandardLogs(appId);
        allow delete: if false;
      }
    }

    // Phien chuan hoa danh phap: luu snapshot bat bien va chi cho phep APPLIED -> UNDONE.
    match /artifacts/{appId}/standard_cleanup_batches/{batchId} {
      allow read: if hasPermission(appId, 'standard_edit');
      allow create: if hasPermission(appId, 'standard_edit') &&
        request.resource.data.status == 'APPLIED' &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if hasPermission(appId, 'standard_edit') &&
        resource.data.status == 'APPLIED' &&
        request.resource.data.status == 'UNDONE' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'undoneAt', 'undoneBy', 'undoneByName'
        ]) &&
        request.resource.data.undoneBy == request.auth.uid;
      allow delete: if false;
    }

    // Technical ownership ledger for the reusable A/B/C code sequence (and
    // the explicitly supported SDHET business code). It is never exposed as
    // a second business identifier.
    match /artifacts/{appId}/standard_code_registry/{code} {
      function canMarkLegacyRegistryMigrated(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let migratedTo = request.resource.data.get('migratedTo', '');
        let canonicalPath = /databases/$(database)/documents/artifacts/$(appId)/standard_code_registry/$(migratedTo);
        return hasPermission(appId, 'standard_edit') &&
          !validInternalId(code) &&
          changed.hasOnly(['migrationStatus', 'migratedTo', 'migratedAt', 'lastUpdated']) &&
          request.resource.data.get('migrationStatus', '') == 'MIGRATED' &&
          validInternalId(migratedTo) &&
          request.resource.data.migratedAt == request.time &&
          request.resource.data.lastUpdated == request.time &&
          existsAfter(canonicalPath) &&
          getAfter(canonicalPath).data.get('id', '') == migratedTo &&
          getAfter(canonicalPath).data.get('internal_id', '') == migratedTo;
      }

      function validRegistryHolder(appId) {
        let holderId = request.resource.data.get('currentStandardId', '');
        let holderPath = /databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(holderId);
        return holderId is string && holderId.size() > 0 &&
          existsAfter(holderPath) &&
          getAfter(holderPath).data.get('internal_id', '') == code &&
          getAfter(holderPath).data.get('lifecycle_status', 'ACTIVE') == 'ACTIVE';
      }

      function canReuseAssignedRegistrySlot(appId) {
        let registryPath = /databases/$(database)/documents/artifacts/$(appId)/standard_code_registry/$(code);
        let previousHolderId = exists(registryPath) ? resource.data.get('currentStandardId', '') : '';
        let previousHolderPath = /databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(previousHolderId);
        return !exists(registryPath) ||
          resource.data.get('status', '') != 'ASSIGNED' ||
          request.resource.data.get('status', '') != 'ASSIGNED' ||
          previousHolderId == request.resource.data.get('currentStandardId', '') ||
          (
            previousHolderId is string && previousHolderId.size() > 0 &&
            existsAfter(previousHolderPath) &&
            ['RELEASED', 'CLOSED'].hasAny([
              getAfter(previousHolderPath).data.get('lifecycle_status', 'ACTIVE')
            ]) &&
            getAfter(previousHolderPath).data.get('internal_id_released_at', null) == request.time
          );
      }

      allow read: if hasPermission(appId, 'standard_view') || hasPermission(appId, 'standard_edit');
      allow create: if hasPermission(appId, 'standard_edit') &&
        validInternalId(code) &&
        request.resource.data.keys().hasOnly([
          'id', 'internal_id', 'status', 'currentStandardId', 'assignmentCount',
          'lastAssignedAt', 'lastReleasedAt', 'lastReleasedStandardId', 'lastUpdated'
        ]) &&
        request.resource.data.get('id', '') == code &&
        request.resource.data.get('internal_id', '') == code &&
        ['ASSIGNED', 'AVAILABLE', 'CONFLICT'].hasAny([request.resource.data.get('status', '')]) &&
        request.resource.data.get('assignmentCount', 0) is number &&
        request.resource.data.get('assignmentCount', 0) >= 0 &&
        request.resource.data.lastUpdated == request.time &&
        canReuseAssignedRegistrySlot(appId) &&
        (
          request.resource.data.get('status', '') != 'ASSIGNED' ||
          validRegistryHolder(appId)
        );
      allow update: if canMarkLegacyRegistryMigrated(appId) || (
        hasPermission(appId, 'standard_edit') &&
        validInternalId(code) &&
        request.resource.data.keys().hasOnly([
          'id', 'internal_id', 'status', 'currentStandardId', 'assignmentCount',
          'lastAssignedAt', 'lastReleasedAt', 'lastReleasedStandardId', 'lastUpdated'
        ]) &&
        request.resource.data.get('id', '') == code &&
        request.resource.data.get('internal_id', '') == code &&
        ['ASSIGNED', 'AVAILABLE', 'CONFLICT'].hasAny([request.resource.data.get('status', '')]) &&
        request.resource.data.get('assignmentCount', 0) is number &&
        request.resource.data.get('assignmentCount', 0) >= 0 &&
        request.resource.data.lastUpdated == request.time &&
        canReuseAssignedRegistrySlot(appId) &&
        (
          request.resource.data.get('status', '') != 'ASSIGNED' ||
          validRegistryHolder(appId)
        )
      );
      allow delete: if false;
    }

    // Immutable audit record for a legacy-code synchronization batch.
    match /artifacts/{appId}/standard_code_sync_batches/{batchId} {
      allow read: if hasPermission(appId, 'standard_edit');
      allow create: if hasPermission(appId, 'standard_edit') &&
        request.resource.data.status == 'APPLIED' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.recordCount is number &&
        request.resource.data.recordCount > 0 &&
        request.resource.data.changes is list;
      allow update, delete: if false;
    }

    // Yeu cau mua chuan (Purchase/Standard Requests)
    match /artifacts/{appId}/standard_requests/{reqId} {
      function validRequesterStandardRequestCreate(appId) {
        let data = request.resource.data;
        let standardPath = /databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(data.get('standardId', ''));
        let standard = get(standardPath);
        return hasPermission(appId, 'standard_request') &&
          data.keys().hasAll([
            'id', 'standardId', 'standardName', 'requestedBy', 'requestedByName',
            'requestDate', 'purpose', 'status', 'totalAmountUsed', 'usageLogs',
            'createdAt', 'updatedAt', '_isDeleted', 'lastUpdated'
          ]) &&
          data.keys().hasOnly([
            'id', 'standardId', 'standardName', 'lotNumber', 'requestedBy',
            'requestedByName', 'requestDate', 'purpose', 'expectedAmount',
            'status', 'sopTags', 'totalAmountUsed', 'usageLogs', 'internalId', 'createdAt',
            'updatedAt', '_isDeleted', 'lastUpdated'
          ]) &&
          data.id == reqId &&
          data.standardId is string && data.standardId.size() > 0 &&
          exists(standardPath) &&
          data.standardName is string && data.standardName.size() > 0 &&
          data.standardName == standard.data.get('name', '') &&
          (!('lot_number' in standard.data)
            ? !('lotNumber' in data)
            : data.get('lotNumber', '') == standard.data.get('lot_number', '')) &&
          data.requestedBy == request.auth.uid &&
          data.requestedByName is string && data.requestedByName.size() > 0 &&
          isCurrentActorName(appId, data.requestedByName) &&
          data.requestDate is number &&
          data.purpose is string && data.purpose.size() > 0 &&
          (!('expectedAmount' in data) || (data.expectedAmount is number && data.expectedAmount >= 0)) &&
          data.status == 'PENDING_APPROVAL' &&
          data.totalAmountUsed == 0 &&
          data.usageLogs is list && data.usageLogs.size() == 0 &&
          (!('internalId' in data) || data.internalId == standard.data.get('internal_id', '')) &&
          (!('sopTags' in data) || validReturnTagArray(data)) &&
          data.createdAt is number && data.updatedAt is number &&
          data._isDeleted == false &&
          data.lastUpdated == request.time;
      }

      function validStandardRequestCreate(appId) {
        let validTags = validReturnTagArray(request.resource.data) && validFinalReturnTagArray(request.resource.data);
        return validRequesterStandardRequestCreate(appId) || (canOperateStandards(appId) && validTags);
      }

      function validStandardRequestRollback(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return hasPermission(appId, 'standard_log_delete') &&
          changed.hasOnly([
            '_isDeleted', 'status', 'usageLogs', 'totalAmountUsed',
            'rolledBackAt', 'rolledBackBy', 'updatedAt', 'lastUpdated'
          ]) &&
          request.resource.data.totalAmountUsed <= resource.data.totalAmountUsed;
      }

      function validRequesterUsageAccounting(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let stdId = resource.data.get('standardId', '');
        let standardBefore = get(/databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId));
        let standardAfter = getAfter(/databases/$(database)/documents/artifacts/$(appId)/reference_standards/$(stdId));
        let stockDelta = standardBefore.data.get('current_amount', 0) - standardAfter.data.get('current_amount', 0);
        let usageLogId = request.resource.data.get('lastUsageLogId', '');
        return resource.data.get('requestedBy', '') == request.auth.uid &&
          resource.data.get('status', '') == 'IN_PROGRESS' &&
          changed.hasOnly(['totalAmountUsed', 'lastUsageLogId', 'updatedAt', 'lastUpdated']) &&
          changed.hasAny(['totalAmountUsed']) &&
          stockDelta > 0 &&
          standardBefore.data.get('current_holder_uid', '') == request.auth.uid &&
          standardBefore.data.get('current_request_id', '') == reqId &&
          standardAfter.data.get('current_holder_uid', '') == request.auth.uid &&
          standardAfter.data.get('current_request_id', '') == reqId &&
          request.resource.data.get('totalAmountUsed', -1) == resource.data.get('totalAmountUsed', 0) + stockDelta &&
          usageLogId is string && usageLogId.size() > 0 &&
          resource.data.get('lastUsageLogId', '') != usageLogId &&
          request.resource.data.get('updatedAt', 0) is number &&
          request.resource.data.lastUpdated == request.time;
      }

      function validRequesterReturnSubmission(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.requestedBy == request.auth.uid &&
          request.resource.data.requestedBy == resource.data.requestedBy &&
          request.resource.data.standardId == resource.data.standardId &&
          resource.data.status == 'IN_PROGRESS' &&
          request.resource.data.status == 'PENDING_RETURN' &&
          validReturnTagArray(request.resource.data) &&
          changed.hasOnly([
            'status', 'reportedAmountUsed', 'reportedUnit', 'reportedDepleted',
            'sopTags', 'updatedAt', 'lastUpdated'
          ]) &&
          request.resource.data.reportedAmountUsed is number &&
          request.resource.data.reportedAmountUsed >= 0 &&
          request.resource.data.reportedUnit is string &&
          request.resource.data.reportedUnit.size() > 0 &&
          request.resource.data.reportedDepleted is bool &&
          request.resource.data.updatedAt is number &&
          request.resource.data.lastUpdated == request.time;
      }

      function validRequesterResumeUsage(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let resumable = ['PENDING_RETURN', 'PENDING_DEPLETION'].hasAny([resource.data.status]);
        return resource.data.requestedBy == request.auth.uid &&
          request.resource.data.requestedBy == resource.data.requestedBy &&
          request.resource.data.standardId == resource.data.standardId &&
          resumable && request.resource.data.status == 'IN_PROGRESS' &&
          validReturnTagArray(request.resource.data) &&
          changed.hasOnly([
            'status', 'reportedAmountUsed', 'reportedUnit', 'reportedDepleted',
            'sopTags', 'updatedAt', 'lastUpdated'
          ]) &&
          !('reportedAmountUsed' in request.resource.data) &&
          !('reportedUnit' in request.resource.data) &&
          !('reportedDepleted' in request.resource.data) &&
          request.resource.data.updatedAt is number &&
          request.resource.data.lastUpdated == request.time;
      }

      function validRequesterProposalUpdate(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.requestedBy == request.auth.uid &&
          request.resource.data.requestedBy == resource.data.requestedBy &&
          request.resource.data.standardId == resource.data.standardId &&
          request.resource.data.status == resource.data.status &&
          ['PENDING_APPROVAL', 'IN_PROGRESS', 'PENDING_RETURN', 'PENDING_DEPLETION'].hasAny([resource.data.status]) &&
          validReturnTagArray(request.resource.data) &&
          changed.hasOnly(['sopTags', 'updatedAt', 'lastUpdated']) &&
          request.resource.data.updatedAt is number &&
          request.resource.data.lastUpdated == request.time;
      }

      function validRequesterStandardRequestUpdate(appId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (changed.hasAny(['totalAmountUsed']) && validRequesterUsageAccounting(appId)) ||
          (hasPermission(appId, 'standard_request') &&
          !changed.hasAny(['totalAmountUsed', 'usageLogs']) && (
            validRequesterReturnSubmission(appId) ||
            validRequesterResumeUsage(appId) ||
            validRequesterProposalUpdate(appId)
          ));
      }

      function validStandardRequestUpdate(appId) {
        return canRepairStandardRequestSnapshot(appId) ||
          validRequesterStandardRequestUpdate(appId) ||
          (canOperateStandards(appId) &&
          validReturnTagArray(request.resource.data) &&
          validFinalReturnTagArray(request.resource.data)) ||
          validStandardRequestRollback(appId);
      }

      allow read: if canOperateStandards(appId) || hasPermission(appId, 'standard_log_view') ||
        hasPermission(appId, 'standard_log_delete') || (
        isSignedIn() && resource.data.requestedBy == request.auth.uid
      );
      allow create: if validStandardRequestCreate(appId);
      allow update: if validStandardRequestUpdate(appId);
      allow delete: if false;
    }

    // Central custom catalog. Physical deletes are forbidden; lifecycle uses
    // the _isDeleted tombstone so historical request/standard keys can still
    // resolve their labels.
    match /artifacts/{appId}/standard_tags/{tagId} {
      allow read: if hasPermission(appId, 'standard_view');
      allow create: if hasPermission(appId, 'standard_edit') && (
        validManualCatalogItem(request.resource.data) ||
        validAccreditationCatalogItem(request.resource.data)
      );
      allow update: if hasPermission(appId, 'standard_edit') &&
        request.resource.data._isDeleted is bool && (
          (resource.data.locked == true && validAccreditationCatalogItem(request.resource.data) &&
            request.resource.data.origin == resource.data.origin &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'description', 'methodName', 'deviceCodes', 'color', 'sourcePages', 'sortOrder',
              '_isDeleted', 'supersededByDecision', 'supersededAt', 'lastUpdated'
            ])) ||
          (resource.data.locked != true && validManualCatalogItem(request.resource.data))
        );
      allow delete: if false;
    }
    match /artifacts/{appId}/purchase_requests/{reqId} {
      allow read: if canOperateStandards(appId) || (
        isSignedIn() && resource.data.requestedBy == request.auth.uid
      );
      allow create: if canOperateStandards(appId) || (
        hasPermission(appId, 'standard_request') &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'PENDING'
      );
      allow update: if canOperateStandards(appId);
      allow delete: if false;
    }

    // Lich su su dung chuan chung
    match /artifacts/{appId}/standard_usages/{useId} {
      allow read: if hasPermission(appId, 'standard_log_view') ||
        hasPermission(appId, 'standard_log_delete') || canOperateStandards(appId);
      allow create: if validRequesterUsageJournalCreate(
          appId,
          request.resource.data.get('standardId', ''),
          useId,
          request.resource.data
        ) || canOperateStandards(appId);
      allow update: if canRepairStandardUsageSnapshot(appId) ||
        canRollbackStandardLogs(appId);
      allow delete: if false;
    }

    // MODULE QUY TRINH SOP & CONG THUC (SOPS & RECIPES)
    match /artifacts/{appId}/sops/{sopId} {
      allow read: if hasPermission(appId, 'sop_view');
      allow write: if hasPermission(appId, 'sop_edit');

      match /history/{histId} {
        allow read: if hasPermission(appId, 'sop_view');
        allow write: if hasPermission(appId, 'sop_edit');
      }
    }
    match /artifacts/{appId}/recipes/{recipeId} {
      allow read: if hasPermission(appId, 'recipe_view');
      allow write: if hasPermission(appId, 'recipe_edit');
    }

    // MODULE YEU CAU KIEM NGHIEM VA KET QUA (REQUESTS)
    match /artifacts/{appId}/requests/{reqId} {
      allow get: if true; // Public read cho phep truy xuat ket qua/QR code khong can dang nhap
      allow list: if canUseSopWorkspace(appId);
      allow create: if validRequestCreate(appId, request.resource.data);
      allow update: if isManager(appId) || hasPermission(appId, 'sop_approve') || validBatchRequestUpdate(appId);
      allow delete: if isManager(appId);

      match /history/{histId} {
        allow read: if canUseSopWorkspace(appId);
        allow write: if canEditResults(appId);
      }
    }
    match /artifacts/{appId}/daily_checklists/{analysisDate} {
      allow read: if isSignedIn();
      allow write: if isManager(appId) || hasPermission(appId, 'batch_run');
    }
    match /artifacts/{appId}/results_details/{docId} {
      allow read: if canUseSopWorkspace(appId);
      allow create, update: if canEditResults(appId) &&
        request.resource.data.get('requestId', docId) == docId;
      allow delete: if canEditResults(appId) &&
        get(/databases/$(database)/documents/artifacts/$(appId)/requests/$(docId)).data.get('isVirtualMaster', false) == true;
    }

    // Yeu cau in an nhan / barcode (Print Jobs)
    match /artifacts/{appId}/print_jobs/{jobId} {
      allow get, list: if canUseSopWorkspace(appId);
      allow create: if canEditResults(appId) &&
        request.resource.data.get('requestId', '') is string &&
        request.resource.data.get('requestId', '').size() > 0 &&
        request.resource.data.get('createdByUid', '') == request.auth.uid &&
        isCurrentActorName(appId, request.resource.data.get('createdBy', '')) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.lastUpdated == request.time;
      allow update: if false;
      allow delete: if isManager(appId) || hasPermission(appId, 'sop_approve') || (
        isActiveUser(appId) && hasPermission(appId, 'batch_run') &&
        resource.data.get('createdByUid', '') == request.auth.uid
      );
    }

    // Thu vien Target Master
    match /artifacts/{appId}/target_groups/{tgId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId) || hasPermission(appId, 'sop_edit');
    }
    match /artifacts/{appId}/master_targets/{docId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId);
    }
    match /artifacts/{appId}/master_analytes/{docId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId);
    }
    match /artifacts/{appId}/matrix_types/{docId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId);
    }
    match /artifacts/{appId}/master_devices/{docId} {
      allow read: if isSignedIn();
      allow write: if isManager(appId);
    }

    // Lich su Audit Trail / Nhat ky he thong chung (Logs)
    match /artifacts/{appId}/logs/{logId} {
      allow create: if canCreateAuditLog(appId) &&
        validCanonicalActivityCreate(appId, logId, request.resource.data);
      // Public QR lookup is intentionally get-only and requires the explicit
      // BUSINESS traceability bit. Authenticated get/list access is resolved
      // independently through Activity audience, Audit class or Print Queue.
      allow get: if canGetGlobalLog(appId, resource.data);
      allow list: if canListGlobalLog(appId, resource.data);
      allow update, delete: if isManager(appId);
    }
  }
}
