{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx ng build --configuration=production --no-progress",
  "ignoreCommand": "node scripts/vercel-ignore-build.js",
  "outputDirectory": "dist/lims-cloud-pro/browser",
  "framework": "angular",
  "functions": {
    "api/backup/create.ts": {
      "includeFiles": "{gas/**,.clasp.json}"
    },
    "api/backup/status.ts": {
      "includeFiles": "{gas/**,.clasp.json}"
    }
  },
  "crons": [
    {
      "path": "/api/notifications-retention",
      "schedule": "15 18 * * *"
    }
  ],
  "alias": [
    "nafiqpm6.vercel.app",
    "nafiqpm6-babypusscts-projects.vercel.app",
    "nafiqpm6-git-main-babypusscts-projects.vercel.app"
  ],
  "rewrites": [
    { "source": "/__/auth/(.*)", "destination": "https://lims-cloud-by-otada.firebaseapp.com/__/auth/$1" },
    { "source": "/__/firebase/(.*)", "destination": "https://lims-cloud-by-otada.firebaseapp.com/__/firebase/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!__/auth/|__/firebase/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/main-(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/chunk-(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles-(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/ngsw.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, no-transform" }
      ]
    },
    {
      "source": "/ngsw-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, no-transform" }
      ]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, no-transform" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, no-transform" }
      ]
    }
  ]
}
