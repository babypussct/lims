{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "lims-cloud-pro": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/lims-cloud-pro",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "favicon.ico",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/legacy/build",
                "output": "/assets/pdfjs"
              }
            ],
            "styles": [
              "src/styles.css",
              "node_modules/@univerjs/preset-sheets-core/lib/index.css",
              "node_modules/@univerjs/preset-sheets-filter/lib/index.css",
              "node_modules/@univerjs/preset-sheets-find-replace/lib/index.css"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "exceljs",
              "jspdf",
              "html2canvas",
              "chart.js",
              "canvg",
              "raf",
              "rgbcolor",
              "dompurify",
              "pdfmake",
              "jsbarcode",
              "qrcode",
              "dijkstrajs",
              "core-js",
              "async-lock",
              "ot-json1",
              "fast-diff",
              "react",
              "react/jsx-runtime",
              "react-dom",
              "react-dom/client",
              "opentype.js",
              "localforage",
              "prop-types"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "100kb",
                  "maximumError": "200kb"
                }
              ],
              "outputHashing": "all",
              "optimization": true,
              "extractLicenses": false,
              "sourceMap": false,
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "staging": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.staging.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "serviceWorker": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "lims-cloud-pro:build:production"
            },
            "development": {
              "buildTarget": "lims-cloud-pro:build:development"
            },
            "staging": {
              "buildTarget": "lims-cloud-pro:build:staging"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "angular-eslint"
    ],
    "analytics": false,
    "cache": {
      "enabled": true,
      "environment": "all"
    }
  }
}
