# Ignore local Angular cache and dependencies
.angular/
node_modules/
dist/
out-tsc/

# Ignore local configuration and IDE files
# Keep Git metadata available in Git-based Vercel builds so
# scripts/vercel-ignore-build.js can diff HEAD against its parent.
# Vercel CLI excludes .git/ from local uploads independently.
.github/
.vscode/
.idea/
.env
.env.*

# Ignore massive static files that are not required by the serverless backup bundle
FILEBIEUMAUGOC/
temp_inspect_filebieumau3_docx/
template_extracted/
scratch/

# Ignore large documents
Report_ISTD_PARAMETER_NEW.pdf
Report_ISTD_PARAMETER_NEW.xlsx
Report_ISTD_PARAMETER_NEW.*

# Ignore local test scripts and logs
test-*.js
test_*.js
test_format.ts
build_errors*.txt
*.log
