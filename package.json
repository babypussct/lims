    "test:ui-results": "tsx --test src/app/features/results/result-list-ui-primitives.contract.test.ts",
    "test:ui-recipes": "tsx --test src/app/features/recipes/recipe-ui-primitives.contract.test.ts",
    "test:ui-preparation": "tsx --test src/app/features/preparation/smart-prep-ui-primitives.contract.test.ts",
    "test:ui-standards": "tsx --test src/app/features/standards/standards-ui-primitives.contract.test.ts",
    "test:ui-targets": "tsx --test src/app/features/targets/targets-ui-primitives.contract.test.ts",
    "test:ui-documents": "tsx --test src/app/features/documents/documents-ui-primitives.contract.test.ts",
    "test:ui-checklist": "tsx --test src/app/features/checklist/daily-checklist-ui-primitives.contract.test.ts",
    "test:ui-labels": "tsx --test src/app/features/labels/label-print-ui-primitives.contract.test.ts",
    "test:ui-config": "tsx --test src/app/features/config/config-ui-primitives.contract.test.ts",
    "test:settings": "tsx --test src/app/features/settings/settings-routing.test.ts api/account/delete-request.contract.test.ts",
    "test:ui-traceability": "tsx --test src/app/features/traceability/traceability-ui-primitives.contract.test.ts",
    "test:ui-sop": "tsx --test src/app/features/sop/sop-ui-primitives.contract.test.ts",
    "test:ui-auth-public": "tsx --test src/app/features/auth/auth-public-ui-primitives.contract.test.ts",
    "test:service-worker": "tsx --test src/app/core/utils/service-worker-recovery.test.ts",
    "test:documents": "tsx --test src/app/core/services/google-drive.service.test.ts src/app/features/documents/document-viewer.utils.test.ts src/app/features/documents/excel-univer-converter.test.ts src/app/features/documents/excel-univer-metadata.test.ts src/app/features/documents/excel-viewer-tools.test.ts src/app/features/documents/excel-document-demo.component.test.ts",
    "test:results": "tsx --test src/app/features/results/result-pdf-helper.test.ts src/app/features/results/services/report-request-id.test.ts",
    "test:excel-import": "tsx --test src/app/features/results/import/excel-result-import.test.ts",
    "test:smart-batch": "tsx --test src/app/features/batch/smart-batch.utils.test.ts src/app/features/batch/sample-group.utils.test.ts src/app/features/targets/target-scope-classifier.spec.ts src/app/core/services/calculator.service.test.ts src/app/core/services/smart-batch-security-rules.test.ts scripts/standard-request-security-audit.test.ts && npm run test:firestore-rules",
    "test:firestore-rules": "node scripts/run-firestore-rules-tests.js",
    "test:daily-checklists": "tsx --test src/app/core/utils/daily-checklist-projection.test.ts src/app/core/utils/daily-checklist-hotfix.test.ts",
    "test:gas": "tsx --test scripts/gas-report-regression.test.ts",
    "gas:push": "npm run test:gas && npx clasp push",
    "gas:watch": "npx clasp push --watch",
    "test:prep": "tsx --test src/app/features/preparation/prep-calculation.engine.test.ts src/app/features/preparation/smart-prep.boundary.test.ts",
    "test:release": "node --test scripts/release-pipeline.test.js scripts/release-gate.test.js scripts/release-discipline.test.js scripts/vercel-ignore-build.test.js scripts/verify-runtime.test.js && tsx --test src/app/core/services/changelog-fallback.test.ts",
    "test:changelog": "npm run test:release",
    "verify:runtime": "node scripts/verify-runtime.js",
    "validate:release-notes": "node scripts/validate-release-notes.js",
    "migrate:releases": "node scripts/migrate-releases.js",
    "backfill:daily-checklists": "tsx scripts/backfill-daily-checklists.ts",
    "backfill:activity": "tsx scripts/backfill-activity-events.ts",
    "verify:daily-checklists": "tsx scripts/backfill-daily-checklists.ts --verify-only",
    "audit:standard-request-security": "tsx scripts/audit-standard-request-security.ts",
    "lint": "ng lint",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "dump-sops": "node scratch/dump_all_sops.js"
  },
