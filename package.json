{
  "name": "lims-cloud-pro",
  "version": "26.08.31-b02",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.js && node scripts/sync-release-history.js && node scripts/build-changelog-md.js",
    "sync-release-history": "node scripts/sync-release-history.js",
    "release:prepare": "npm run sync-version",
    "release:verify": "npm run verify:runtime && npm test && npx tsc -p tsconfig.app.json --noEmit && npm run typecheck:api && npm run build",
    "release:discipline": "node scripts/release-discipline.js",
    "release:prepush": "npm run verify:runtime && npm run validate:release-notes && npm run release:discipline && node scripts/release-gate.js prepush",
    "release:predeploy": "npm run verify:runtime && npm run validate:release-notes && node scripts/release-discipline.js --base=HEAD^ && node scripts/release-gate.js predeploy",
    "release:patch": "npm run release:prepare",
    "release:minor": "npm run release:prepare",
    "release:major": "npm run release:prepare",
    "deploy:rules": "npm run release:predeploy && npx firebase-tools deploy --only firestore:rules --project lims-cloud-by-otada",
    "deploy:prod": "npm run release:predeploy && npx vercel --prod",
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run validate:release-notes && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:activity && npm run test:standards && npm run test:inventory && npm run test:notifications && npm run test:backup && npm run test:ui-contracts && npm run test:ui-guardrails && npm run test:service-worker && npm run test:documents && npm run test:results && npm run test:excel-import && npm run test:smart-batch && npm run test:daily-checklists && npm run test:gas && npm run test:prep && npm run test:changelog",
