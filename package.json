{
  "name": "lims-cloud-pro",
  "version": "26.08.07-b02",
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "release:patch": "npm version patch --no-git-tag-version && npm run sync-version",
    "release:minor": "npm version minor --no-git-tag-version && npm run sync-version",
    "release:major": "npm version major --no-git-tag-version && npm run sync-version",
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run validate:release-notes && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:standards && npm run test:notifications && npm run test:documents && npm run test:excel-import && npm run test:smart-batch",
    "test:fefo": "tsx --test src/app/shared/utils/standard-fefo.test.ts",
    "test:standards": "tsx --test src/app/shared/utils/standard-fefo.test.ts src/app/shared/utils/standard-amount.test.ts src/app/shared/utils/standard-workflow.test.ts src/app/shared/utils/standard-backfill.test.ts src/app/shared/utils/dashboard-activity.test.ts src/app/shared/utils/standard-rules.test.ts src/app/shared/utils/chemical-name.test.ts src/app/core/services/pubchem.service.test.ts src/app/features/standards/services/standard-import.utils.test.ts src/app/features/standards/services/standard-tag.utils.test.ts src/app/features/standards/services/standard-tag-catalog.service.spec.ts src/app/core/services/delta-sync.test.ts src/app/core/services/firestore-read-monitor.service.test.ts",
    "test:cleanup": "tsx --test src/app/shared/utils/chemical-name.test.ts src/app/shared/utils/standard-cleanup.test.ts src/app/core/services/pubchem.service.test.ts",
    "test:notifications": "tsx --test api/notification-utils.test.ts src/app/core/services/notification-policy.test.ts src/app/core/services/toast.service.test.ts",
    "test:documents": "tsx --test src/app/core/services/google-drive.service.test.ts",
    "test:excel-import": "tsx --test src/app/features/results/import/excel-result-import.test.ts",
    "test:smart-batch": "tsx --test src/app/features/batch/smart-batch.utils.test.ts src/app/core/services/calculator.service.test.ts",
    "validate:release-notes": "node scripts/validate-release-notes.js",
    "migrate:releases": "node scripts/migrate-releases.js",
    "lint": "ng lint",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "dump-sops": "node scratch/dump_all_sops.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/fire": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular/service-worker": "^19.0.0",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/share": "^6.0.4",
    "ag-grid-angular": "^35.3.1",
    "ag-grid-community": "^35.3.1",
    "chart.js": "^4.4.1",
    "exceljs": "^4.4.0",
    "firebase": "^10.12.0",
    "firebase-admin": "^13.9.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.11.6",
    "jspdf": "^2.5.1",
    "pdfjs-dist": "^6.1.200",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@capacitor/cli": "^6.2.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^18.0.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/node": "^5.7.17",
    "angular-eslint": "21.0.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.5.3",
    "typescript-eslint": "8.46.4"
  }
}
