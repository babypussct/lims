    "test:fefo": "tsx --test src/app/shared/utils/standard-fefo.test.ts",
    "test:inventory": "tsx --test src/app/shared/utils/gs1-parser.test.ts",
    "test:standards": "tsx --test src/app/shared/utils/standard-fefo.test.ts src/app/shared/utils/standard-amount.test.ts src/app/shared/utils/standard-workflow.test.ts src/app/shared/utils/standard-backfill.test.ts src/app/shared/utils/standard-internal-id.test.ts src/app/shared/utils/date-range.test.ts src/app/shared/utils/standard-rules.test.ts src/app/shared/utils/chemical-name.test.ts src/app/core/services/pubchem.service.test.ts src/app/core/services/stats.service.test.ts src/app/features/standards/services/standard-import.utils.test.ts src/app/features/standards/services/standard-tag.utils.test.ts src/app/features/standards/services/standard-tag-catalog.service.spec.ts src/app/core/services/delta-sync.test.ts src/app/core/services/firestore-activity-log-rules.test.ts src/app/core/services/firestore-read-monitor.service.test.ts src/app/features/standards/services/standard-internal-id-sync.service.test.ts src/app/features/standards/components/standards-internal-id-sync-modal.component.test.ts",
    "test:cleanup": "tsx --test src/app/shared/utils/chemical-name.test.ts src/app/shared/utils/standard-cleanup.test.ts src/app/core/services/pubchem.service.test.ts",
