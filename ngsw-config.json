{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.10.07-b01",
    "title": "Hiển thị đầy đủ chỉ tiêu ngoài bộ trên bảng theo dõi mẫu ngày",
    "features": [
      "Kiểm nghiệm viên xem được toàn bộ tên chỉ tiêu ngoài bộ trên bảng theo dõi mẫu ngày, cửa sổ xem trước và bản in.",
      "Bố cục in dạng bảng và dạng thẻ tính theo danh sách chỉ tiêu ngoài bộ đầy đủ.",
      "Thay phần rút gọn '+Y chỉ tiêu khác' bằng danh sách tên đầy đủ; các chỉ tiêu thuộc bộ tiếp tục hiển thị theo tên bộ."
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "pdfjs-worker",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/pdfjs/pdf.worker.min.mjs"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
