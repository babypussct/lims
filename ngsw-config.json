{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.08.01-b02",
    "notesVersion": "v26.08.01-b02",
    "title": "Đăng Nhập Google Ổn Định & An Toàn Hơn",
    "features": [
      "🔐 Đăng nhập Google dùng luồng chuyển trang an toàn, không còn phụ thuộc vào cửa sổ bật lên",
      "📱 Cải thiện khả năng đăng nhập trên Safari, thiết bị di động và trình duyệt trong ứng dụng",
      "🧭 Khôi phục đúng màn hình người dùng đang làm việc sau khi đăng nhập"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
