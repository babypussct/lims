{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.07.28-b03",
    "notesVersion": "v26.07.28-b03",
    "title": "Hotfix Xem PDF Trên Mobile",
    "features": [
      "📱 Khắc phục lỗi getOrInsertComputed khiến PDF không mở được trên Chrome/Safari mobile",
      "🧩 Chuyển đồng bộ viewer và worker sang PDF.js legacy build chính thức có lớp tương thích Map/WeakMap",
      "📄 Giữ nguyên chế độ cuộn dọc nhiều trang, chọn/copy chữ và tìm kiếm highlight",
      "✅ Không sửa prototype thủ công và không phát sinh dịch vụ hoặc chi phí mới"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
