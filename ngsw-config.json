{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.11.06-b03",
    "title": "Sửa danh sách nhãn phương pháp khi hoàn trả chuẩn",
    "features": [
      "Danh sách nhãn phương pháp thử trong Hoàn trả chuẩn hiển thị gọn trong hộp thoại, hỗ trợ tên phương pháp dài.",
      "Danh sách có thanh cuộn, tự xuống dòng và thu gọn sau khi chọn; áp dụng cả khi Admin tiếp nhận chuẩn trả.",
      "Khắc phục danh sách lựa chọn tràn màn hình và che nội dung hộp thoại.",
      "Ngăn chọn trùng nhãn đã thêm và giữ giới hạn 10 nhãn."
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "pdfjs-worker",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/pdfjs/pdf.worker.min.mjs"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
