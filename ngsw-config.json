{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.07.29-b01",
    "notesVersion": "v26.07.29-b01",
    "title": "Import Excel Lớn Không Treo & Ghép Mẫu Sequence",
    "features": [
      "⚡ Đọc workbook trong Web Worker, không khóa giao diện khi file có nhiều sắc ký đồ",
      "🎯 Chỉ phân tích sheet thuộc SOP và bỏ qua hình, chart, style cùng dữ liệu phụ",
      "🔗 Ghép chung xxx_ngày_mã-mẫu với mã-mẫu+ngày, gồm FIPRONIL_27_U01.D → U0127",
      "🧪 Khôi phục BLANK, SPIKE, SPIKE_N SOP-01 và alias Master Analyte lịch sử"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
