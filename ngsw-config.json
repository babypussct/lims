{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.08.01-b05",
    "notesVersion": "v26.08.01-b05",
    "title": "Hoàn Tất Cấu Hình Firebase Đăng Nhập Google",
    "features": [
      "🔐 Firebase hoàn tất đăng nhập Google ổn định trên môi trường production",
      "🧩 Cung cấp đầy đủ cấu hình khởi tạo cho thành phần xác thực Firebase",
      "🛡️ Giữ bảo vệ chống nhúng cho ứng dụng, đồng thời cho phép endpoint xác thực hoạt động đúng"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
