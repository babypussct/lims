{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.08.04-b10",
    "title": "Trang Chủ tải nhẹ hơn theo quyền truy cập",
    "features": [
      "Trang Chủ chỉ tải các khu vực phù hợp với quyền được cấp.",
      "Mở hệ thống nhẹ hơn đối với tài khoản không sử dụng Báo cáo hoặc Vận hành SOP.",
      "Các thao tác duyệt và vận hành vẫn cập nhật số liệu đầy đủ.",
      "Báo cáo chỉ tải khi tài khoản có quyền Xem Báo cáo.",
      "Bảng theo dõi mẫu chỉ tải khi tài khoản có quyền Vận hành SOP."
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
