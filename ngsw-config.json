{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.08.04-b07",
    "title": "Sửa Firestore Index cho Activity Logs",
    "features": [
      "Loại bỏ failed-precondition khi tải activity logs của người dùng.",
      "Giữ listener cá nhân realtime ở mức tối đa 100 bản ghi.",
      "Không cần tạo composite index mới cho luồng logs hiện tại.",
      "Query cá nhân dùng equality filter + limit và sắp xếp kết quả ở client.",
      "Read monitor tiếp tục ghi nhận initial/delta và nguồn cache của listener."
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
