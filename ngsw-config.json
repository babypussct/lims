{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.07.29-b03",
    "notesVersion": "v26.07.29-b03",
    "title": "Toast DeltaSync Đúng Sự Kiện",
    "features": [
      "🔕 Người vừa import chỉ nhận một toast kết quả, không bị DeltaSync phát lại thông báo thứ hai",
      "🎯 Mỗi thay đổi metadata mang đúng phiên bản, người thực hiện và nội dung sự kiện",
      "🧹 Listener không còn lấy activity log cũ để gắn nhầm Propoxur vào import mới",
      "🛡️ Sự kiện cũ hoặc không khớp chỉ hiện thông báo đồng bộ chung, không suy diễn bản ghi đã thay đổi"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
