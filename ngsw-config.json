{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.10.01-b02",
    "title": "Khôi phục mã QR chất chuẩn và in nhãn",
    "features": [
      "Mã QR chất chuẩn hiển thị trở lại để quét, phóng to và in nhãn.",
      "Giữ liên kết trong mã QR chất chuẩn đồng nhất với liên kết chia sẻ.",
      "Sửa lỗi ảnh QR chất chuẩn không hiển thị trên bản phát hành chính thức.",
      "Sửa cùng nguyên nhân gây lỗi tạo QR khi in nhãn và giữ các luồng đăng nhập, truy xuất bằng QR hoạt động ổn định."
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "pdfjs-worker",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/pdfjs/pdf.worker.min.mjs"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
