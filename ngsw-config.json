{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.08.01-b06",
    "notesVersion": "v26.08.01-b06",
    "title": "Liên Kết Google & Mật Khẩu Đăng Nhập",
    "features": [
      "🔐 Tài khoản Google có thể thiết lập mật khẩu LIMS để đăng nhập bằng Gmail hoặc email",
      "🔗 Liên kết Google và mật khẩu trên cùng một tài khoản Firebase, giữ nguyên hồ sơ và dữ liệu",
      "🛠️ Sửa luồng redirect localhost bằng authDomain hỗ trợ đúng endpoint khởi tạo Firebase"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
