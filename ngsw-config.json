{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.07.28-b04",
    "notesVersion": "v26.07.28-b04",
    "title": "Excel Tự Dãn Vừa Nội Dung",
    "features": [
      "📐 Tự AutoFit cột và hàng ngay khi mở workbook hoặc chuyển sheet",
      "📝 Tự tăng chiều cao cho nội dung xuống dòng, wrap và ô dài vượt giới hạn cột",
      "📱 Giới hạn kích thước thông minh riêng cho mobile để bảng không bị phình",
      "🖱️ Bổ sung nút Vừa nội dung để khôi phục AutoFit sau khi chỉnh thủ công"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
