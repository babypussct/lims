{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.08.01-b01",
    "notesVersion": "v26.08.01-b01",
    "title": "Khắc Phục Lỗi Đăng Nhập Popup & PDF Viewer",
    "features": [
      "🔧 Tự động nhận diện trình duyệt chặn popup đăng nhập và chuyển hướng sang OIDC (Redirect)",
      "📄 Sửa lỗi tương thích cú pháp mảng Array Spread của Map.entries() trên trình duyệt cũ giúp xem tài liệu PDF ổn định hơn"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
