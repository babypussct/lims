{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.08.01-b08",
    "notesVersion": "v26.08.01-b08",
    "title": "Bắt Buộc Hoàn Tất Mật Khẩu Sau Đăng Nhập Google",
    "features": [
      "🚪 Sau khi Google redirect thành công, dashboard tự mở form và yêu cầu hoàn tất mật khẩu LIMS",
      "🔗 Kiểm tra cờ onboarding trên cùng hồ sơ Firebase, không phụ thuộc việc người dùng có vào menu Cài đặt hay không",
      "🛡️ Đồng bộ trạng thái hoàn tất trên Firestore với Rules chỉ cho phép chính chủ cập nhật"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
