{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.08.03-b01",
    "notesVersion": "v26.08.03-b01",
    "title": "Sửa Lỗi Kẹt Màn Hình Thiết Lập Mật Khẩu",
    "features": [
      "🔒 Người dùng Google không còn bị kẹt mãi ở modal nhập mật khẩu dù đã lưu thành công",
      "⚡ Ba lớp bảo vệ chống race condition giữa Firestore snapshot và optimistic state",
      "🛡️ Bảo vệ localPasswordConfigured khỏi bị ghi đè bởi cache cũ"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
