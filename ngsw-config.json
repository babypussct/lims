{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.11.18-b01",
    "title": "Sửa lỗi ghi nhận và in kết quả SOP 9.14",
    "features": [
      "Giữ nguyên giá trị kết quả đã nhập khi cờ ND cũ vẫn còn bật trong SOP 9.14.",
      "Đồng bộ cách nhận diện mẫu phát hiện và mẫu không phát hiện giữa phiếu đầy đủ, phiếu gộp và PDF.",
      "Khắc phục trường hợp PDF bỏ trống kết quả đã báo cáo do cờ ND chưa được cập nhật.",
      "Khắc phục trạng thái phát hiện bị xác định sai khi giá trị kết quả và cờ ND không nhất quán."
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "pdfjs-worker",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/pdfjs/pdf.worker.min.mjs"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
