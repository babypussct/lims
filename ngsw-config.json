{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "v26.08.02-b01",
    "notesVersion": "v26.08.02-b01",
    "title": "Quản Lý Mật Khẩu Và Khôi Phục Tài Khoản An Toàn",
    "features": [
      "🔑 Cho phép tạo, đổi và khôi phục mật khẩu LIMS ngay trong ứng dụng",
      "🔗 Quản lý liên kết Google và mật khẩu trên cùng một tài khoản",
      "🛡️ Bảo vệ thao tác nhạy cảm bằng xác thực lại và quy tắc chỉ cho phép chính chủ cập nhật"
    ]
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "feature-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
